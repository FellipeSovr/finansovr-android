<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wp_raiz" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/wd_fundo" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@mipmap/ic_launcher_round" android:importantForAccessibility="no" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Hoje"
            android:textColor="@color/wd_t2" android:textSize="12sp" android:fontFamily="@font/fz_jakarta_600" />
    </LinearLayout>
    <TextView android:id="@+id/wp_valor" android:layout_width="match_parent" android:layout_height="34dp" android:layout_marginTop="12dp"
        android:autoSizeMaxTextSize="25sp" android:autoSizeMinTextSize="14sp" android:autoSizeTextType="uniform" android:gravity="center_vertical"
        android:maxLines="1" android:textColor="@color/wd_tx" android:fontFamily="@font/fz_jakarta_800" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp">
        <ProgressBar android:id="@+id/wp_barra" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:max="1000" android:progressDrawable="@drawable/wd_barra" />
        <ProgressBar android:id="@+id/wp_barra_neg" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp"
            android:max="1000" android:progressDrawable="@drawable/wd_barra_neg" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/wp_gasto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:ellipsize="end" android:maxLines="1" android:textColor="@color/wd_t2" android:textSize="11.5sp" />
    <TextView android:id="@+id/wp_estado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:maxLines="1" android:textColor="@color/wd_ok" android:textSize="11.5sp" android:fontFamily="@font/fz_jakarta_700" />
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/wp_rodape" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1"
        android:textColor="@color/wd_t3" android:textSize="10sp" />
</LinearLayout>
